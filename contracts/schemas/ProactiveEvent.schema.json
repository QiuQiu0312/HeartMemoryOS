{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://companion-memory.invalid/v2/schemas/ProactiveEvent.schema.json",
  "title": "ProactiveEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "eventId", "relationshipId", "kind", "origin", "summary", "schedule",
    "generationMode", "channel", "consentReceipt", "settingsRevisionAtCreate", "state", "revision", "idempotencyFingerprint",
    "createdAt", "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "eventId": { "$ref": "#/$defs/Id" },
    "relationshipId": { "$ref": "#/$defs/Id" },
    "conversationId": { "type": ["string", "null"], "maxLength": 128 },
    "kind": { "enum": ["transactional_reminder", "onboarding_in_app", "relationship_proactive", "anniversary", "scheduled_greeting", "story_event", "marketing"] },
    "origin": { "enum": ["explicit_user_request", "onboarding", "approved_product_rule", "approved_relationship_rule", "migration"] },
    "sourceMessageIds": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/Id" },
      "uniqueItems": true
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "schedule": { "$ref": "#/$defs/Schedule" },
    "generationMode": { "enum": ["template_only", "template_or_model", "model_or_skip"] },
    "templateId": { "type": ["string", "null"], "maxLength": 128 },
    "channel": { "enum": ["in_app", "device_local", "app_push", "web_push", "email", "sms", "bot"] },
    "consentReceipt": { "$ref": "#/$defs/ConsentReceipt" },
    "settingsRevisionAtCreate": { "type": "integer", "minimum": 1 },
    "state": {
      "enum": ["scheduled", "paused", "completed", "cancelled", "expired", "failed"],
      "description": "Durable schedule state only. Per-send progress belongs to latestOccurrenceState; completing one recurring occurrence does not complete the event."
    },
    "revision": { "type": "integer", "minimum": 1 },
    "idempotencyFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{16,64}$",
      "description": "Non-reversible, display-safe fingerprint; the submitted idempotency key is never returned."
    },
    "logicalOccurrenceId": { "type": ["string", "null"], "maxLength": 128 },
    "latestOccurrenceState": {
      "type": ["string", "null"],
      "enum": ["scheduled", "leased", "policy_checked", "generated", "outbox_committed", "provider_accepted", "delivered", "opened", "completed", "cancelled", "expired", "failed", null],
      "description": "Optional diagnostic state for the latest materialized occurrence; never use it as authorization."
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "cancelledAt": { "type": ["string", "null"], "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "transactional_reminder" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "origin": { "const": "explicit_user_request" },
          "consentReceipt": { "properties": { "purpose": { "const": "proactive_transactional" } } }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "onboarding_in_app" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "consentReceipt": { "properties": { "purpose": { "const": "proactive_onboarding" } } }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "enum": ["relationship_proactive", "anniversary", "scheduled_greeting", "story_event"] } }, "required": ["kind"] },
      "then": {
        "properties": {
          "consentReceipt": { "properties": { "purpose": { "const": "proactive_relationship" } } }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "marketing" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "consentReceipt": { "properties": { "purpose": { "const": "proactive_marketing" } } }
        }
      }
    }
  ],
  "$defs": {
    "Id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "Schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dueAtUtc", "localDateTime", "timezone", "dstPolicy", "quietHoursPolicy", "latePolicy"],
      "properties": {
        "dueAtUtc": { "type": "string", "format": "date-time" },
        "localDateTime": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9](?::[0-5][0-9])?$",
          "description": "Local wall-clock time without UTC offset; resolve with timezone and dstPolicy."
        },
        "timezone": { "type": "string", "minLength": 1, "maxLength": 128 },
        "dstPolicy": { "enum": ["reject_ambiguous", "earlier_offset", "later_offset", "shift_forward"] },
        "quietHoursPolicy": { "enum": ["deliver_at_requested_time", "move_to_next_allowed_time", "skip_if_quiet", "reject_on_create_if_quiet"] },
        "latePolicy": { "enum": ["send_until_expiry", "skip_if_late", "ask_on_create"] },
        "expiresAt": { "type": ["string", "null"], "format": "date-time" },
        "recurrenceRRule": {
          "type": ["string", "null"],
          "maxLength": 512,
          "pattern": "^[^\\r\\n]+$",
          "description": "Validated server-side against a bounded RFC 5545 subset and finite expansion horizon."
        }
      }
    },
    "ConsentReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consentEventId", "purpose", "consentRevision", "policyVersion", "grantedAt", "checkedAt"],
      "properties": {
        "consentEventId": { "$ref": "#/$defs/Id" },
        "purpose": { "enum": ["proactive_transactional", "proactive_onboarding", "proactive_relationship", "proactive_marketing"] },
        "consentRevision": { "type": "integer", "minimum": 1 },
        "policyVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "grantedAt": { "type": "string", "format": "date-time" },
        "checkedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
