{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://companion-memory.invalid/v2/schemas/ContextEnvelope.schema.json",
  "title": "ContextEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "turnId",
    "promptPlanId",
    "contextRevision",
    "stableBlocks",
    "dynamicBlocks",
    "recentMessages",
    "currentMessage",
    "tokenAccounting",
    "retrievalMode",
    "degraded",
    "versions"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "turnId": { "$ref": "#/$defs/Id" },
    "contextRevision": { "type": "integer", "minimum": 1 },
    "promptPlanId": { "$ref": "#/$defs/Id" },
    "stableBlocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/StableBlock" }
    },
    "dynamicBlocks": {
      "type": "array",
      "maxItems": 12,
      "items": { "$ref": "#/$defs/DynamicBlock" }
    },
    "recentMessages": {
      "type": "array",
      "maxItems": 40,
      "items": { "$ref": "#/$defs/HistoricalMessage" }
    },
    "currentMessage": { "$ref": "#/$defs/CurrentUserMessage" },
    "tokenAccounting": { "$ref": "#/$defs/TokenAccounting" },
    "retrievalMode": { "enum": ["none", "exact", "hybrid", "deep"] },
    "recallTraceId": { "type": ["string", "null"], "maxLength": 128 },
    "degraded": { "type": "boolean" },
    "degradationReasons": {
      "type": "array",
      "maxItems": 16,
      "items": { "type": "string", "maxLength": 128 },
      "uniqueItems": true
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persona", "promptPlan", "policy", "tokenizer"],
      "properties": {
        "persona": { "type": "string", "maxLength": 128 },
        "promptPlan": { "type": "string", "maxLength": 128 },
        "policy": { "type": "string", "maxLength": 128 },
        "tokenizer": { "type": "string", "maxLength": 128 },
        "retrievalConfig": { "type": "string", "maxLength": 128 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "degraded": { "const": true } }, "required": ["degraded"] },
      "then": { "required": ["degradationReasons"], "properties": { "degradationReasons": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "degraded": { "const": false } }, "required": ["degraded"] },
      "then": { "properties": { "degradationReasons": { "maxItems": 0 } } }
    }
  ],
  "$defs": {
    "Id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "Realm": {
      "enum": ["real_world", "relationship_canon", "roleplay", "fictional", "hypothetical", "quoted", "unknown"]
    },
    "StableBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockId", "kind", "content", "version", "estimatedTokens", "trust"],
      "properties": {
        "blockId": { "$ref": "#/$defs/Id" },
        "kind": { "enum": ["product_safety", "core_persona", "tool_policy"] },
        "content": { "type": "string", "maxLength": 30000 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "estimatedTokens": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "trust": { "const": "trusted_instruction" },
        "cacheKey": { "type": ["string", "null"], "maxLength": 256 }
      }
    },
    "DynamicBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockId", "kind", "content", "estimatedTokens", "trust", "sourceIds"],
      "properties": {
        "blockId": { "$ref": "#/$defs/Id" },
        "kind": {
          "enum": ["adaptive_profile", "user_profile", "relationship_profile", "conversation_state", "recalled_memories", "current_correction_overlay"]
        },
        "content": {
          "oneOf": [
            { "type": "string", "maxLength": 20000 },
            {
              "type": "array",
              "maxItems": 12,
              "items": { "$ref": "#/$defs/MemoryContextItem" }
            }
          ]
        },
        "estimatedTokens": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "trust": { "enum": ["untrusted_data", "verified_projection"] },
        "sourceIds": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/Id" },
          "uniqueItems": true
        }
      }
    },
    "MemoryContextItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memoryId", "text", "realm", "attribution", "epistemicBasis", "confidenceBand", "validTimeKind", "recordedAt", "status", "evidenceState"],
      "properties": {
        "memoryId": { "$ref": "#/$defs/Id" },
        "text": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "realm": { "$ref": "#/$defs/Realm" },
        "attribution": {
          "enum": ["user_self_report", "user_about_other", "companion_statement", "system_observed", "imported", "inferred"]
        },
        "epistemicBasis": {
          "enum": ["explicit_memory_request", "explicit_statement", "user_confirmation", "repeated_inference", "behavioral_signal", "assistant_generated", "quoted_report", "imported_record", "unknown"]
        },
        "confidenceBand": { "enum": ["explicit", "high", "medium", "low", "disputed"] },
        "validTimeKind": { "enum": ["timeless", "point", "interval", "recurring", "unknown"] },
        "validFrom": { "type": ["string", "null"], "format": "date-time" },
        "validTo": { "type": ["string", "null"], "format": "date-time" },
        "recordedAt": { "type": "string", "format": "date-time" },
        "status": { "enum": ["active", "contested", "historical"] },
        "evidenceState": { "enum": ["user_confirmed", "direct_evidence", "inferred", "evidence_unavailable"] },
        "evidenceIds": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/Id" },
          "uniqueItems": true
        }
      }
    },
    "HistoricalMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messageId", "role", "content", "createdAt"],
      "properties": {
        "messageId": { "$ref": "#/$defs/Id" },
        "role": { "enum": ["user", "assistant", "tool"] },
        "content": { "type": "string", "maxLength": 20000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "realmHint": { "$ref": "#/$defs/Realm" },
        "toolCallId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "toolName": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,127}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "role": { "const": "tool" } }, "required": ["role"] },
          "then": { "required": ["toolCallId", "toolName"] },
          "else": { "properties": { "toolCallId": false, "toolName": false } }
        }
      ]
    },
    "CurrentUserMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messageId", "role", "content", "createdAt"],
      "properties": {
        "messageId": { "$ref": "#/$defs/Id" },
        "role": { "const": "user" },
        "content": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "TokenAccounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelContextLimit", "reservedOutput", "toolAndWrapperTokens", "safetyMarginTokens", "compiledInputTokens", "hardLimitSatisfied"],
      "properties": {
        "modelContextLimit": { "type": "integer", "minimum": 1 },
        "reservedOutput": { "type": "integer", "minimum": 0 },
        "toolAndWrapperTokens": { "type": "integer", "minimum": 0 },
        "safetyMarginTokens": { "type": "integer", "minimum": 0 },
        "compiledInputTokens": { "type": "integer", "minimum": 0 },
        "hardLimitSatisfied": { "const": true },
        "blockTokens": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
