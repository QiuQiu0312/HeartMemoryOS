# 复制为 .env；也可以运行 npm run setup 自动生成安全随机值。
MEMORYOS_DEMO=true
MEMORYOS_LOCAL_COMPANION=true
MEMORYOS_HOST=127.0.0.1
MEMORYOS_PORT=8787
MEMORYOS_DB_PATH=./data/heartmemory.sqlite
MEMORYOS_RUNTIME_PATH=./data/runtime-state.json
MEMORYOS_LOCAL_CONFIG_PATH=./data/local-companion.json
MEMORYOS_LOCAL_SECRETS_PATH=./data/local-secrets.json
MEMORYOS_LOCAL_STATE_PATH=./data/local-companion-state.json

# 至少 32 字节。不要提交真实值，不要在前端或 APP 包内保存生产密钥。
MEMORYOS_AUTH_SECRET=replace-with-at-least-32-random-bytes
MEMORYOS_FINGERPRINT_KEY=replace-with-another-32-byte-secret

# 浏览器跨域默认关闭。仅填写实际控制台地址，不要使用 *。
MEMORYOS_ALLOWED_ORIGIN=http://127.0.0.1:3000,http://localhost:3000

# 本地聊天页中的模型配置保存在上面的本机 data 文件；密钥不会返回给浏览器。
# MEMORYOS_LOCAL_COMPANION 只应在本机回环地址开启，正式服务器请关闭并接入自己的鉴权与密钥系统。
# 关系主动消息默认关闭；没有独立授权和后台开关时不会发送。
